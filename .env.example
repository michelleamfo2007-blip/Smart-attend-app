# ── Required (web / Vercel Production) ──────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Prefer JWT_SECRET. SUPABASE_JWT_SECRET is accepted as a legacy alias.
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"

NEXT_PUBLIC_APP_URL="https://www.smartattend.co"

# ── Email (optional but recommended) ────────────────────────────
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="SmartAttend <noreply@yourdomain.com>"

# ── Stripe (required only if you take card payments) ────────────
STRIPE_SECRET_KEY="sk_live_xxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxx"
STRIPE_STARTER_PRICE_ID="price_xxxxxxxx"
STRIPE_PRO_PRICE_ID="price_xxxxxxxx"

# ── Optional / debug ───────────────────────────────────────────
# ATTENDANCE_SKIP_GPS="true"
# APP_URL="https://www.smartattend.co"
# CRON_SECRET="long-random-string"   # Protects /api/cron/sessions (Vercel Cron)

# ── Mobile (Expo) — set in smart-attend-mobile/.env ─────────────
# EXPO_PUBLIC_API_URL="https://www.smartattend.co"
