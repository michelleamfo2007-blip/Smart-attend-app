generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model users {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String?
  email     String?  @unique
  password  String?
  role      String?
  level     String?
  semester  String?
  device_id String?
  
  classes_lectured      classes[]              @relation("lecturer")
  attendance_sessions   attendance_sessions[]  @relation("session_lecturer")
}

model classes {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  lecturer_id   String   @db.Uuid
  level         String?
  semester      String?
  schedule_time String?
  invite_code   String?  @unique
  start_time    String?
  end_time      String?

  lecturer      users    @relation("lecturer", fields: [lecturer_id], references: [id], onDelete: Cascade)
  sessions      attendance_sessions[]
  records       attendance_records[]
}

model attendance_sessions {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_id    String   @db.Uuid
  lecturer_id String   @db.Uuid
  latitude    Float?
  longitude   Float?
  status      String   @default("active")
  expires_at  DateTime @db.Timestamptz
  created_at  DateTime @default(now()) @db.Timestamptz

  class       classes  @relation(fields: [class_id], references: [id], onDelete: Cascade)
  lecturer    users    @relation("session_lecturer", fields: [lecturer_id], references: [id], onDelete: Cascade)
  records     attendance_records[]
}

model attendance_records {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_id     String   @db.Uuid
  student_id   String   @db.Uuid
  student_name String?
  timestamp    DateTime @db.Timestamptz
  session_id   String   @db.Uuid
  location     String?

  class        classes  @relation(fields: [class_id], references: [id], onDelete: Cascade)
  session      attendance_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@unique([student_id, session_id])
}

model active_sessions {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_id    String   @db.Uuid
  lecturer_id String   @db.Uuid
  latitude    Float?
  longitude   Float?
  active      Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz
}

model attendance_disputes {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id  String   @db.Uuid
  session_id  String   @db.Uuid
  class_id    String   @db.Uuid
  reason      String?
  status      String   @default("pending")
  created_at  DateTime @default(now()) @db.Timestamptz
}
