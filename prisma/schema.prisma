generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model users {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String?  @db.Uuid
  name           String?
  email          String?  @unique
  password       String?
  role           String?
  level          String?
  semester       String?
  device_id      String?
  student_id     String?
  staff_id       String?
  department     String?
  program        String?
  cohort_id      String?  @db.Uuid
  programme_id   String?  @db.Uuid
  
  programme_rel         programmes?            @relation(fields: [programme_id], references: [id], onDelete: SetNull)
  institution           institutions?          @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  cohort                cohorts?               @relation(fields: [cohort_id], references: [id], onDelete: SetNull)
  classes_lectured      classes[]              @relation("lecturer")
  attendance_sessions   attendance_sessions[]  @relation("session_lecturer")
  enrollments           enrollments[]
  records               attendance_records[]
  imports               import_history[]
}

model import_history {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String   @db.Uuid
  uploaded_by    String   @db.Uuid
  file_name      String
  import_type    String
  success_count  Int      @default(0)
  failed_count   Int      @default(0)
  created_at     DateTime @default(now()) @db.Timestamptz

  institution    institutions @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  admin          users        @relation(fields: [uploaded_by], references: [id], onDelete: Cascade)
}

model classes {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String?  @db.Uuid
  name           String
  lecturer_id    String?  @db.Uuid
  level          String?
  semester       String?
  schedule_time  String?
  invite_code    String?  @unique
  start_time     String?
  end_time       String?
  classroom_id   String?  @db.Uuid
  course_code    String?
  credit_hours   Int?     @default(3)
  is_compulsory  Boolean  @default(true)
  programme_id   String?  @db.Uuid

  programme     programmes?          @relation(fields: [programme_id], references: [id], onDelete: SetNull)
  institution   institutions?        @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  lecturer      users?               @relation("lecturer", fields: [lecturer_id], references: [id], onDelete: SetNull)
  classroom     classrooms?          @relation(fields: [classroom_id], references: [id], onDelete: SetNull)
  sessions      attendance_sessions[]
  records       attendance_records[]
  enrollments   enrollments[]
  cohort_classes cohort_classes[]
}

model classrooms {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String   @db.Uuid
  name           String
  latitude       Float?
  longitude      Float?
  radius_meters  Int      @default(50)
  created_at     DateTime @default(now()) @db.Timestamptz

  institution    institutions @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  classes        classes[]
}

model cohorts {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String   @db.Uuid
  name           String
  created_at     DateTime @default(now()) @db.Timestamptz

  institution    institutions @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  users          users[]
  cohort_classes cohort_classes[]
}

model cohort_classes {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cohort_id  String   @db.Uuid
  class_id   String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz

  cohort     cohorts  @relation(fields: [cohort_id], references: [id], onDelete: Cascade)
  class      classes  @relation(fields: [class_id], references: [id], onDelete: Cascade)

  @@unique([cohort_id, class_id])
}

model attendance_sessions {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_id        String   @db.Uuid
  lecturer_id     String   @db.Uuid
  attendance_code String?
  latitude        Float?
  longitude       Float?
  status          String   @default("active")
  expires_at      DateTime @db.Timestamptz
  created_at      DateTime @default(now()) @db.Timestamptz

  class       classes  @relation(fields: [class_id], references: [id], onDelete: Cascade)
  lecturer    users    @relation("session_lecturer", fields: [lecturer_id], references: [id], onDelete: Cascade)
  records     attendance_records[]
}

model attendance_records {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_id     String   @db.Uuid
  student_id   String   @db.Uuid
  session_id   String   @db.Uuid
  student_name String?
  timestamp    DateTime @db.Timestamptz
  location     String?

  class        classes             @relation(fields: [class_id], references: [id], onDelete: Cascade)
  student      users               @relation(fields: [student_id], references: [id], onDelete: Cascade)
  session      attendance_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@unique([student_id, session_id])
}

model enrollments {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id String   @db.Uuid
  class_id   String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz

  student    users    @relation(fields: [student_id], references: [id], onDelete: Cascade)
  class      classes  @relation(fields: [class_id], references: [id], onDelete: Cascade)
  
  @@unique([student_id, class_id])
}

model active_sessions {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_id    String   @db.Uuid
  lecturer_id String   @db.Uuid
  latitude    Float?
  longitude   Float?
  active      Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz
}

model attendance_disputes {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id  String   @db.Uuid
  session_id  String   @db.Uuid
  class_id    String   @db.Uuid
  reason      String?
  status      String   @default("pending")
  created_at  DateTime @default(now()) @db.Timestamptz
}

model system_settings {
  id                   String @id @default("global")
  lecturer_invite_code String @default("LECTURER-2026")
}

model institutions {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  domain            String?  @unique
  logo              String?
  contact_email     String?
  phone_number      String?
  subscription_plan String?  @default("free")
  status            String   @default("active")
  billing_cycle     String   @default("monthly")
  trial_period      Boolean  @default(false)
  max_users         Int?
  api_access        Boolean  @default(false)
  sso               Boolean  @default(false)
  custom_branding   Boolean  @default(false)
  invite_code       String?  @unique
  notes             String?
  created_at        DateTime @default(now()) @db.Timestamptz
  updated_at        DateTime @updatedAt @db.Timestamptz

  users             users[]
  classes           classes[]
  classrooms        classrooms[]
  cohorts           cohorts[]
  imports           import_history[]
  colleges          colleges[]
}

model colleges {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String   @db.Uuid
  name           String
  created_at     DateTime @default(now()) @db.Timestamptz

  institution    institutions @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  departments    departments[]
}

model departments {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  college_id   String   @db.Uuid
  name         String
  created_at   DateTime @default(now()) @db.Timestamptz

  college      colleges @relation(fields: [college_id], references: [id], onDelete: Cascade)
  programmes   programmes[]
}

model programmes {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  department_id String   @db.Uuid
  name          String
  created_at    DateTime @default(now()) @db.Timestamptz

  department    departments @relation(fields: [department_id], references: [id], onDelete: Cascade)
  classes       classes[]
  users         users[]
}
