generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model users {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String?  @db.Uuid
  name           String?
  email          String?  @unique
  password       String?
  role           String?
  level          String?
  semester       String?
  device_id      String?
  device_fingerprint String?
  student_id     String?
  staff_id       String?
  department     String?
  program        String?
  cohort_id      String?  @db.Uuid
  programme_id   String?  @db.Uuid
  needs_device_reset Boolean @default(false)
  can_mark_attendance Boolean @default(false)
  
  programme_rel         programmes?            @relation(fields: [programme_id], references: [id], onDelete: SetNull)
  institution           institutions?          @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  cohort                cohorts?               @relation(fields: [cohort_id], references: [id], onDelete: SetNull)
  classes_lectured      classes[]              @relation("lecturer")
  attendance_sessions   attendance_sessions[]  @relation("session_lecturer")
  lecturer_verifications lecturer_location_verifications[] @relation("lecturer_verifications")
  enrollments           enrollments[]
  records               attendance_records[]
  marked_records        attendance_records[]   @relation("attendance_marker")
  attendance_flags      attendance_flags[]     @relation("attendance_flagger")
  imports               import_history[]
  audit_logs            audit_logs[]
  notifications         user_notifications[]
}

model import_history {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String   @db.Uuid
  uploaded_by    String   @db.Uuid
  file_name      String
  import_type    String
  success_count  Int      @default(0)
  failed_count   Int      @default(0)
  created_at     DateTime @default(now()) @db.Timestamptz

  institution    institutions @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  admin          users        @relation(fields: [uploaded_by], references: [id], onDelete: Cascade)
}

model classes {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String?  @db.Uuid
  name           String
  lecturer_id    String?  @db.Uuid
  level          String?
  semester       String?
  schedule_time  String?
  invite_code    String?  @unique
  start_time     String?
  end_time       String?
  classroom_id   String?  @db.Uuid
  course_code    String?
  credit_hours   Int?     @default(3)
  is_compulsory  Boolean  @default(true)
  programme_id   String?  @db.Uuid

  programme     programmes?          @relation(fields: [programme_id], references: [id], onDelete: SetNull)
  institution   institutions?        @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  lecturer      users?               @relation("lecturer", fields: [lecturer_id], references: [id], onDelete: SetNull)
  classroom     classrooms?          @relation(fields: [classroom_id], references: [id], onDelete: SetNull)
  sessions      attendance_sessions[]
  records       attendance_records[]
  enrollments   enrollments[]
  cohort_classes cohort_classes[]
}

model classrooms {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String   @db.Uuid
  name           String
  building       String?
  latitude       Float?
  longitude      Float?
  radius_meters  Int      @default(50)
  created_at     DateTime @default(now()) @db.Timestamptz

  institution    institutions @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  classes        classes[]
  kiosks         classroom_kiosks[]
}

model classroom_kiosks {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String    @db.Uuid
  classroom_id   String    @db.Uuid
  name           String
  /// Optional physical device identifier (asset tag / hostname)
  device_label   String?
  access_token   String    @unique
  enabled        Boolean   @default(true)
  last_seen_at   DateTime? @db.Timestamptz
  created_at     DateTime  @default(now()) @db.Timestamptz

  institution    institutions @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  classroom      classrooms   @relation(fields: [classroom_id], references: [id], onDelete: Cascade)
}

model cohorts {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String   @db.Uuid
  name           String
  created_at     DateTime @default(now()) @db.Timestamptz

  institution    institutions @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  users          users[]
  cohort_classes cohort_classes[]
}

model cohort_classes {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cohort_id  String   @db.Uuid
  class_id   String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz

  cohort     cohorts  @relation(fields: [cohort_id], references: [id], onDelete: Cascade)
  class      classes  @relation(fields: [class_id], references: [id], onDelete: Cascade)

  @@unique([cohort_id, class_id])
}

model attendance_sessions {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_id           String    @db.Uuid
  lecturer_id        String    @db.Uuid
  attendance_code    String?
  latitude           Float?
  longitude          Float?
  status             String    @default("active") // scheduled | active | closed
  expires_at         DateTime  @db.Timestamptz
  scheduled_start    DateTime? @db.Timestamptz
  scheduled_end      DateTime? @db.Timestamptz
  attendance_method  String    @default("both") // dynamic_qr | short_code | both
  auto_created       Boolean   @default(false)
  code_expires_at    DateTime? @db.Timestamptz
  /// Last successful on-demand lecturer geofence check for this session (not continuous tracking)
  lecturer_verified_at DateTime? @db.Timestamptz
  created_at         DateTime  @default(now()) @db.Timestamptz

  class       classes  @relation(fields: [class_id], references: [id], onDelete: Cascade)
  lecturer    users    @relation("session_lecturer", fields: [lecturer_id], references: [id], onDelete: Cascade)
  records     attendance_records[]
  lecturer_verifications lecturer_location_verifications[]

  @@unique([class_id, scheduled_start])
}

/// On-demand lecturer location checks only (no background trail).
model lecturer_location_verifications {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id     String   @db.Uuid
  lecturer_id        String   @db.Uuid
  session_id         String?  @db.Uuid
  class_id           String?  @db.Uuid
  classroom_id       String?  @db.Uuid
  latitude           Float
  longitude          Float
  accuracy_meters    Float?
  expected_latitude  Float?
  expected_longitude Float?
  expected_radius_m  Int?
  distance_meters    Float?
  result             String   // passed | failed | skipped_no_anchor
  policy             String   // off | warn | block
  created_at         DateTime @default(now()) @db.Timestamptz

  institution institutions @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  lecturer    users        @relation("lecturer_verifications", fields: [lecturer_id], references: [id], onDelete: Cascade)
  session     attendance_sessions? @relation(fields: [session_id], references: [id], onDelete: SetNull)
}

model attendance_records {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_id     String   @db.Uuid
  student_id   String   @db.Uuid
  session_id   String   @db.Uuid
  student_name String?
  timestamp    DateTime @db.Timestamptz
  location     String?
  method       String?  @default("dynamic_qr")
  /// present | late (absent = no record after session closes)
  check_in_status String @default("present")
  /// Required for staff manual marks; optional otherwise
  notes        String?
  /// self | staff_verified
  verification_type String @default("self")
  marked_by_id String?  @db.Uuid

  class        classes             @relation(fields: [class_id], references: [id], onDelete: Cascade)
  student      users               @relation(fields: [student_id], references: [id], onDelete: Cascade)
  session      attendance_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade)
  marked_by    users?              @relation("attendance_marker", fields: [marked_by_id], references: [id], onDelete: SetNull)
  flags        attendance_flags[]

  @@unique([student_id, session_id])
}

/// Librarian/staff flags for suspicious attendance (does not delete records).
model attendance_flags {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String @db.Uuid
  record_id   String?  @db.Uuid
  session_id  String?  @db.Uuid
  student_id  String?  @db.Uuid
  flagged_by  String   @db.Uuid
  reason      String
  status      String   @default("open") // open | reviewed | dismissed
  created_at  DateTime @default(now()) @db.Timestamptz

  institution institutions @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  record      attendance_records? @relation(fields: [record_id], references: [id], onDelete: SetNull)
  flagged_by_user users @relation("attendance_flagger", fields: [flagged_by], references: [id], onDelete: Cascade)
}

model enrollments {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id String   @db.Uuid
  class_id   String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz

  student    users    @relation(fields: [student_id], references: [id], onDelete: Cascade)
  class      classes  @relation(fields: [class_id], references: [id], onDelete: Cascade)
  
  @@unique([student_id, class_id])
}

model active_sessions {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_id    String   @db.Uuid
  lecturer_id String   @db.Uuid
  latitude    Float?
  longitude   Float?
  active      Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz
}

model attendance_disputes {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id  String   @db.Uuid
  session_id  String   @db.Uuid
  class_id    String   @db.Uuid
  reason      String?
  status      String   @default("pending")
  created_at  DateTime @default(now()) @db.Timestamptz
}

model system_settings {
  id                   String @id @default("global")
  lecturer_invite_code String @default("LECTURER-2026")
}

model institutions {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  domain            String?  @unique
  logo              String?
  contact_email     String?
  phone_number      String?
  subscription_plan String?  @default("free")
  status            String   @default("active")
  billing_cycle     String   @default("monthly")
  trial_period      Boolean  @default(false)
  max_users         Int?
  subscription_ends_at DateTime? @db.Timestamptz
  api_access        Boolean  @default(false)
  sso               Boolean  @default(false)
  custom_branding   Boolean  @default(false)
  invite_code       String?  @unique
  notes             String?
  /// IANA timezone, e.g. Africa/Accra — set at institution signup from the admin's device
  timezone          String   @default("Africa/Accra")
  /// Configurable class periods [{ key, name, start_time, end_time, enabled }]
  session_periods   Json?
  /// Lecturer on-demand geofence: off | warn | block
  lecturer_geo_policy String @default("warn")
  /// Optional campus-wide fallback when a classroom has no GPS
  campus_latitude   Float?
  campus_longitude  Float?
  campus_radius_meters Int?  @default(200)
  /// Minutes after session start before check-in is Late (not hard-coded forever)
  late_grace_minutes Int @default(15)
  /// Tenant Admin role permission matrix (JSON). Locked keys always normalize to safe defaults.
  role_permissions  Json?
  created_at        DateTime @default(now()) @db.Timestamptz
  updated_at        DateTime @updatedAt @db.Timestamptz

  users             users[]
  classes           classes[]
  classrooms        classrooms[]
  cohorts           cohorts[]
  imports           import_history[]
  colleges          colleges[]
  kiosks            classroom_kiosks[]
  lecturer_verifications lecturer_location_verifications[]
  attendance_flags  attendance_flags[]
  audit_logs        audit_logs[]
}

model colleges {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution_id String   @db.Uuid
  name           String
  created_at     DateTime @default(now()) @db.Timestamptz

  institution    institutions @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  departments    departments[]
}

model departments {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  college_id   String   @db.Uuid
  name         String
  created_at   DateTime @default(now()) @db.Timestamptz

  college      colleges @relation(fields: [college_id], references: [id], onDelete: Cascade)
  programmes   programmes[]
}

model programmes {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  department_id String   @db.Uuid
  name          String
  created_at    DateTime @default(now()) @db.Timestamptz

  department    departments @relation(fields: [department_id], references: [id], onDelete: Cascade)
  classes       classes[]
  users         users[]
}

model audit_logs {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String?  @db.Uuid
  institution_id String?  @db.Uuid
  session_id     String?  @db.Uuid
  student_id     String?  @db.Uuid
  role           String?
  /// success | failure | warning | info
  result         String?  @default("info")
  action         String
  details        String?
  /// Optional structured payload for filters / forensics
  metadata       Json?
  ip_address     String?
  created_at     DateTime @default(now()) @db.Timestamptz

  user        users?        @relation(fields: [user_id], references: [id], onDelete: SetNull)
  institution institutions? @relation(fields: [institution_id], references: [id], onDelete: SetNull)
}

/// In-app notifications (lecturer session started, etc.) — not push.
model user_notifications {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  title      String
  body       String
  category   String   @default("general")
  read       Boolean  @default(false)
  metadata   Json?
  created_at DateTime @default(now()) @db.Timestamptz

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, read, created_at])
}
